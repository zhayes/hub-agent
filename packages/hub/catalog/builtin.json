      "variants": [
        {
          "id": "default",
          "detect": {
            "kind": "which",
            "name": "qwen"
          },
          "command": "qwen --acp"
        }
      ]
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "name": "claude-code",
      "notes": "需要 ACP 适配器 claude-code-acp（由适配器提供 ACP 入口，而不是 claude 本身）。",
      "variants": [
        {
