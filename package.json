{
  "name": "hub-agent",
  "version": "0.0.0-m0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p packages/hub/tsconfig.json --noEmit",
    "lint": "biome check packages/hub/src packages/hub/test",
    "lint:fix": "biome check --write packages/hub/src packages/hub/test",
    "test:unit": "vitest run",
    "test:kill9": "tsx packages/hub/test/manual/kill9-test.ts",
    "test:srt-acp": "tsx packages/hub/test/manual/srt-acp-smoke.ts",
    "arch": "depcruise packages/hub/src --config .dependency-cruiser.cjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm arch",
    "hubagent": "tsx packages/hub/src/bin/hubagent.ts",
    "hubagentd": "tsx packages/hub/src/bin/hubagentd.ts",
    "doctor": "tsx packages/hub/src/bin/hubagent.ts doctor",
    "bench": "tsx packages/hub/src/bench/run.ts",
    "test:brain-real": "tsx packages/hub/test/manual/real-brain-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.9.0",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
